server {
    listen 80;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 10m;

    access_log /dev/stdout combined;
    error_log /dev/stderr warn;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'" always;

    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store";
    }

    # 고객용 산출물 재다운로드 API는 Spring이 서빙한다(CustomerDeliveryController,
    # /api/external/v1/deliveries/{contractNo}). 아래 /api/ 블록보다 먼저 와야
    # FastAPI로 새지 않는다. 발급 메일에 실리는 Endpoint URL이 이 경로다.
    location /api/external/ {
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $spring_api_upstream ${SPRING_API_UPSTREAM};
        proxy_pass http://$spring_api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Docker Compose 기본값은 backend-api:8000이다. 다른 EC2 또는 내부 ALB를
    # 사용할 때는 BACKEND_API_UPSTREAM 환경변수로 host:port를 주입한다.
    location /api/ {
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $backend_api_upstream ${BACKEND_API_UPSTREAM};
        proxy_pass http://$backend_api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 910s;
    }
}
